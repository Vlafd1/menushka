            const chosenName = itemEl.getAttribute("data-prod-name");
            const chosenCategory = itemEl.getAttribute("data-prod-category");

            // Підставляємо назву строго українською мовою
            inputName.value = chosenName;

            // Перемикаємо селектор відділу на відповідну категорію
            let mappedAisleKey = CATEGORY_TO_AISLE_KEY[chosenCategory] || "other";
            if (mappedAisleKey === "cheese") mappedAisleKey = "dairy";

            if (mappedAisleKey && aisleSelect.querySelector(`option[value="${mappedAisleKey}"]`)) {
              aisleSelect.value = mappedAisleKey;
              updateAisleTitle();
            }
            hideList();
          });
        });

        listContainer.classList.remove("hidden");
      });

      inputName.addEventListener("blur", () => {
        setTimeout(hideList, 200);
      });

      row.querySelector(".remove-row-btn").addEventListener("click", () => {
        row.remove();
      });

      container.appendChild(row);
      lucide.createIcons();
    }

