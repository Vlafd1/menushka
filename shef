          <i data-lucide="trash-2" class="w-4 h-4"></i>
        </button>
      `;

      const inputName = row.querySelector(".ing-name");
      const listContainer = row.querySelector(".ing-autocomplete-list");
      const aisleSelect = row.querySelector(".ing-aisle");

      const updateAisleTitle = () => {
        const selectedOption = aisleSelect.options[aisleSelect.selectedIndex];
        if (selectedOption) {
          aisleSelect.title = selectedOption.text;
        }
      };
      updateAisleTitle();
      aisleSelect.addEventListener("change", updateAisleTitle);

      // Логіка автокомпліту
      const hideList = () => {
        listContainer.classList.add("hidden");
        listContainer.innerHTML = "";
      };

      inputName.addEventListener("input", () => {
        const query = inputName.value;
        const matches = searchIngredients(query);

        if (!query.trim()) {
          hideList();
          return;
        }

        if (matches.length === 0) {
          listContainer.innerHTML = `
            <div class="px-3 py-2 text-xs text-zinc-400 dark:text-zinc-500 italic select-none">
              Новий інгредієнт
