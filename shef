          if (aisleKey === "cheese") aisleKey = "dairy";
          const aisleInfo = AISLES[aisleKey] || AISLES.other;
          return `
            <div data-prod-name="${item.name}" data-prod-category="${item.category}" class="autocomplete-item flex items-center justify-between gap-2 px-3 py-2 text-sm rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800 active:bg-orange-500/10 cursor-pointer transition-colors">
