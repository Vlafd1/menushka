          <option value="dairy" ${safeAisle === "dairy" ? "selected" : ""}>🥛 Молочне та яйця</option>
          <option value="vegetables" ${safeAisle === "vegetables" ? "selected" : ""}>🥦 Овочі та зелень</option>
          <option value="fruits" ${safeAisle === "fruits" ? "selected" : ""}>🍎 Фрукти та ягоди</option>
          <option value="grocery" ${safeAisle === "grocery" ? "selected" : ""}>🍝 Бакалія</option>
          <option value="fish" ${safeAisle === "fish" ? "selected" : ""}>🐟 Риба</option>
          <option value="spices" ${safeAisle === "spices" ? "selected" : ""}>🧂 Спеції та олія</option>
