    function bindRecipeCardEvents() {
      lucide.createIcons();

      document.querySelectorAll(".recipe-card").forEach(card => {
        const id = card.dataset.recipeId;
        const recipe = recipes.find(r => r.id === id);
        if (!recipe) return;

        card.querySelectorAll(".recipe-open-details").forEach(el => {
          el.addEventListener("click", () => openRecipeDetails(recipe));
        });

        const incBtn = card.querySelector(".inc-btn");
        if (incBtn) {
          incBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            selectedMenu[id] = (selectedMenu[id] || 0) + 1;
            saveMenu();
            renderMenuFeed();
            updateFloatingCartBadge();
          });
        }

        const decBtn = card.querySelector(".dec-btn");
        if (decBtn) {
          decBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            if (selectedMenu[id] > 1) {
              selectedMenu[id]--;
            } else {
              delete selectedMenu[id];
            }
            saveMenu();
            renderMenuFeed();
            updateFloatingCartBadge();
          });
        }

        const editBtn = card.querySelector(".edit-recipe-btn");
        if (editBtn) {
          editBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            openEditRecipeModal(recipe);
          });
        }
      });
    }

    function updateFloatingCartBadge() {
      const totalDishes = Object.values(selectedMenu).reduce((a, b) => a + b, 0);
      const badge = document.getElementById("floatingCartBadge");
      badge.innerText = `${totalDishes} ${pluralize(totalDishes, ['страва', 'страви', 'страв'])}`;
    }

    function pluralize(n, forms) {
      n = Math.abs(n) % 100;
      const n1 = n % 10;
      if (n > 10 && n < 20) return forms[2];
      if (n1 > 1 && n1 < 5) return forms[1];
      if (n1 === 1) return forms[0];
      return forms[2];
    }

