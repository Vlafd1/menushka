<!DOCTYPE html>
<html lang="uk" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>МЕНЮШКА — Меню та закупівлі</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            orange: {
              500: '#F97316',
              600: '#EA580C',
            }
          }
        }
      }
    }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    * {
      font-family: 'Inter', sans-serif;
      -webkit-tap-highlight-color: transparent;
      box-sizing: border-box;
    }

    body, html {
      background-color: #0f1013;
      overflow-x: hidden;
      width: 100%;
    }

    html:not(.dark) body, html:not(.dark) {
      background-color: #f8fafc;
    }

    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    body.modal-open {
      overflow: hidden !important;
    }

    .theme-transition * {
      transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease;
    }
  </style>
</head>
<body class="theme-transition min-h-screen text-zinc-900 dark:text-zinc-100 flex justify-center selection:bg-orange-500/20">

  <!-- Головний мобільний контейнер -->
  <div class="w-full max-w-md min-h-screen flex flex-col relative pb-32">
    
    <!-- ЄДИНА ФІКСОВАНА ВЕРХНЯ ОБОРТКА (ШАПКА + КАТЕГОРІЇ) ЧЕРЕЗ FIXED -->
    <header class="fixed top-0 left-0 right-0 z-40 w-full bg-white dark:bg-[#121316] border-b border-zinc-200 dark:border-zinc-800 shadow-sm transition-colors">
      <div class="max-w-md mx-auto w-full">
        <!-- Верхній рядок: Логотип МЕНЮШКА та кнопки -->
        <div class="flex items-center justify-between gap-3 px-4 py-3">
          <!-- Логотип -->
          <div class="flex items-center">
            <span class="text-xl font-black tracking-tight text-zinc-900 dark:text-white uppercase select-none">
              МЕНЮШКА
            </span>
          </div>

          <!-- Кнопки керування (строго однакова висота h-10) -->
          <div class="flex items-center gap-3 shrink-0">
            <!-- Кнопка зміни теми -->
            <button 
              type="button" 
              id="themeToggleBtn" 
              aria-label="Перемкнути тему"
              class="w-10 h-10 rounded-full flex items-center justify-center bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300 dark:border-zinc-700 active:scale-95 transition-all shrink-0"
            >
              <i data-lucide="moon" class="w-5 h-5 hidden dark:block"></i>
              <i data-lucide="sun" class="w-5 h-5 block dark:hidden"></i>
            </button>

            <!-- Кнопка «+ Новий рецепт» -->
            <button 
              type="button" 
              id="openNewRecipeBtn"
              class="h-10 px-4 rounded-xl bg-orange-500 active:bg-orange-600 text-white font-bold text-xs flex items-center justify-center gap-1.5 shadow-md shadow-orange-500/20 active:scale-95 transition-all whitespace-nowrap shrink-0"
            >
              + Новий рецепт
            </button>
          </div>
        </div>

        <!-- Горизонтальна панель швидких категорій -->
        <div data-categories-nav class="flex items-center gap-2 px-4 py-2 border-t border-zinc-100 dark:border-zinc-800/60">
          <!-- Скролящийся список категорій -->
          <div class="flex-1 flex items-center gap-2 overflow-x-auto no-scrollbar py-0.5">
            <div id="categoryTabsContainer" class="flex items-center gap-2"></div>
          </div>

          <!-- Фіксована компактна квадратна кнопка з плюсиком праворуч -->
          <button 
            type="button" 
            id="openCategoriesModalBtn" 
            title="Керувати категоріями"
            aria-label="Керувати категоріями"
            class="w-8 h-8 shrink-0 flex items-center justify-center rounded-xl bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-600 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/60 active:scale-95 transition-all"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 4v16m8-8H4"/>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- СТРІЧКА СТРАВ (ОСНОВНИЙ КОНТЕНТ З КОМПЕНСАЦІЄЮ ВІДСТУПУ PT-28) -->
    <main id="menuFeed" class="flex-1 px-4 pt-28 pb-4 space-y-6">
      <!-- Секції страв рендеряться динамічно -->
    </main>

    <!-- ПЛАВАЮЧА КНОПКА «СПИСОК ЗАКУПІВЛІ» -->
    <div class="fixed bottom-4 inset-x-0 z-30 flex justify-center px-4 pointer-events-none">
      <button 
        type="button" 
        id="openShoppingModalBtn" 
        class="pointer-events-auto w-full max-w-md bg-orange-500 active:bg-orange-600 text-white rounded-2xl py-3 px-4 shadow-xl shadow-orange-500/30 flex items-center justify-between font-bold text-sm transition-transform active:scale-98"
      >
        <span class="flex items-center gap-2">
          <i data-lucide="shopping-bag" class="w-5 h-5"></i>
          <span>Список закупівлі</span>
        </span>
        <span id="floatingCartBadge" class="bg-white/20 px-2.5 py-1 rounded-xl text-xs">0 страв</span>
      </button>
    </div>

  </div>

  <!-- ================= МОДАЛЬНІ ВІКНА (CENTRAL DIALOGS) ================= -->

  <!-- 1. МОДАЛЬНЕ ВІКНО РЕЦЕПТА (ДЕТАЛІ) -->
  <div id="recipeModal" class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-200">
    <div class="relative w-full max-w-md max-h-[85vh] bg-white dark:bg-[#16181d] border border-zinc-200 dark:border-zinc-800 rounded-3xl shadow-2xl flex flex-col overflow-hidden overscroll-contain transition-transform duration-200 scale-95">
      
      <!-- Хедер з фото -->
      <div class="relative h-48 w-full bg-zinc-200 dark:bg-zinc-800 shrink-0">
        <img id="modalRecipeImage" src="" alt="Фото страви" class="w-full h-full object-cover">
        <div id="modalRecipePlaceholder" class="w-full h-full flex items-center justify-center bg-zinc-200 dark:bg-zinc-800">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-orange-500 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/>
            <circle cx="12" cy="13" r="3"/>
          </svg>
        </div>
        <button type="button" class="close-modal-btn absolute top-3 right-3 w-8 h-8 rounded-full bg-black/50 text-white flex items-center justify-center backdrop-blur-sm active:scale-90 transition-transform">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
        <span id="modalRecipeTime" class="absolute bottom-3 left-3 bg-black/60 backdrop-blur-sm text-white px-2 py-0.5 rounded-lg text-xs font-semibold flex items-center gap-1"></span>
      </div>

      <!-- Інфо та таби -->
      <div class="p-4 flex flex-col flex-1 overflow-hidden">
        <span id="modalRecipeCategory" class="text-xs font-bold uppercase tracking-wider text-orange-500"></span>
        <h3 id="modalRecipeTitle" class="text-lg font-bold text-zinc-900 dark:text-white mt-0.5 mb-3"></h3>

        <!-- Перемикач табів: Інгредієнти / Приготування -->
        <div class="grid grid-cols-2 gap-1.5 p-1 bg-zinc-100 dark:bg-zinc-800/80 rounded-xl mb-3 shrink-0">
          <button type="button" id="tabBtnIngredients" class="py-1.5 text-xs font-bold rounded-lg text-white bg-orange-500 transition-all">
            Інгредієнти
          </button>
          <button type="button" id="tabBtnInstructions" class="py-1.5 text-xs font-bold rounded-lg text-zinc-600 dark:text-zinc-400 transition-all">
            Приготування
          </button>
        </div>

        <!-- Контент табів -->
        <div class="flex-1 overflow-y-auto overscroll-contain pr-1 space-y-2 text-sm text-zinc-700 dark:text-zinc-300">
          <ul id="modalRecipeIngredients" class="divide-y divide-zinc-100 dark:divide-zinc-800/60"></ul>
          <div id="modalRecipeInstructions" class="hidden whitespace-pre-line leading-relaxed text-xs sm:text-sm"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- 2. МОДАЛЬНЕ ВІКНО «СПИСОК ЗАКУПІВЛІ» -->
  <div id="shoppingModal" class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-200">
    <div class="relative w-full max-w-md max-h-[85vh] bg-white dark:bg-[#16181d] border border-zinc-200 dark:border-zinc-800 rounded-3xl shadow-2xl flex flex-col overflow-hidden overscroll-contain transition-transform duration-200 scale-95">
      
      <!-- Шапка модалки -->
      <div class="p-4 border-b border-zinc-200 dark:border-zinc-800 flex items-center justify-between shrink-0">
        <div class="flex items-center gap-2">
          <i data-lucide="shopping-bag" class="w-5 h-5 text-orange-500"></i>
          <h3 class="font-bold text-base text-zinc-900 dark:text-white">Список закупівлі</h3>
        </div>
        <button type="button" class="close-modal-btn w-8 h-8 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 flex items-center justify-center active:scale-90 transition-transform">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>

      <!-- Контент списку (згідно з відділами) -->
      <div id="shoppingListContent" class="flex-1 overflow-y-auto overscroll-contain p-4 space-y-4">
        <!-- Створюється через JS -->
      </div>

      <!-- Нижня панель дій: Telegram та Копіювати -->
      <div class="p-4 border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-[#121316] flex gap-2 shrink-0">
        <button 
          type="button" 
          id="telegramExportBtn" 
          class="flex-1 bg-[#229ED9] active:bg-[#1c8ec4] text-white font-bold py-2.5 px-3 rounded-xl text-xs flex items-center justify-center gap-2 transition-transform active:scale-95 shadow-md shadow-[#229ED9]/20"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .36z"/>
          </svg>
          <span>В Telegram</span>
        </button>
        <button 
          type="button" 
          id="copyShoppingListBtn" 
          class="bg-zinc-200 dark:bg-zinc-800 active:bg-zinc-300 dark:active:bg-zinc-700 text-zinc-800 dark:text-zinc-200 font-bold py-2.5 px-3.5 rounded-xl text-xs flex items-center justify-center gap-1.5 transition-transform active:scale-95"
        >
          <i data-lucide="copy" class="w-4 h-4"></i>
          <span>Копіювати</span>
        </button>
      </div>
    </div>
  </div>

  <!-- 3. МОДАЛЬНЕ ВІКНО «ДОДАТИ СВІЙ РЕЦЕПТ» -->
  <div id="newRecipeModal" class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-200">
    <div class="relative w-full max-w-md max-h-[85vh] bg-white dark:bg-[#16181d] border border-zinc-200 dark:border-zinc-800 rounded-3xl shadow-2xl flex flex-col overflow-hidden overscroll-contain transition-transform duration-200 scale-95">
      
      <!-- Шапка -->
      <div class="p-4 border-b border-zinc-200 dark:border-zinc-800 flex items-center justify-between shrink-0">
        <h3 id="recipeModalFormTitle" class="font-bold text-base text-zinc-900 dark:text-white">Додати свій рецепт</h3>
        <button type="button" class="close-modal-btn w-8 h-8 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 flex items-center justify-center active:scale-90 transition-transform">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>

      <!-- Тіло форми -->
      <form id="newRecipeForm" class="flex-1 overflow-y-auto overflow-x-hidden overscroll-contain p-4 space-y-4">
        <input type="hidden" id="editingRecipeId" value="">

        <!-- Назва страви -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-zinc-500 mb-1">Назва страви *</label>
          <input type="text" id="recipeTitleInput" required placeholder="Напр. Паста з креветками" class="w-full bg-zinc-100 dark:bg-[#20232a] border border-zinc-300 dark:border-zinc-700 rounded-xl px-3 py-2 text-sm text-zinc-900 dark:text-white focus:outline-none focus:border-orange-500">
        </div>

        <!-- Категорія та Час приготування -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-zinc-500 mb-1">Категорія *</label>
          <select id="recipeCategorySelect" required class="w-full bg-zinc-100 dark:bg-[#20232a] border border-zinc-300 dark:border-zinc-700 rounded-xl px-3 py-2 text-sm text-zinc-900 dark:text-white focus:outline-none focus:border-orange-500"></select>
        </div>

        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-zinc-500 mb-1">Кількість порцій *</label>
            <input type="number" id="recipePortionsInput" required min="1" step="1" placeholder="Напр. 2" class="w-full bg-zinc-100 dark:bg-[#20232a] border border-zinc-300 dark:border-zinc-700 rounded-xl px-3 py-2 text-sm text-zinc-900 dark:text-white focus:outline-none focus:border-orange-500">
          </div>
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-zinc-500 mb-1">Час (хв)</label>
            <input type="number" id="recipeTimeInput" min="1" max="300" placeholder="Напр. 25" class="w-full bg-zinc-100 dark:bg-[#20232a] border border-zinc-300 dark:border-zinc-700 rounded-xl px-3 py-2 text-sm text-zinc-900 dark:text-white focus:outline-none focus:border-orange-500">
          </div>
        </div>

        <!-- Фото страви (опціонально) -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-zinc-500 mb-1">Фото страви (опціонально)</label>
          <div class="flex items-center gap-3">
            <div id="imagePreviewBox" class="w-14 h-14 rounded-xl border border-dashed border-zinc-300 dark:border-zinc-700 flex items-center justify-center overflow-hidden bg-zinc-100 dark:bg-[#20232a] shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-orange-500 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/>
                <circle cx="12" cy="13" r="3"/>
              </svg>
            </div>
            <label class="flex-1 cursor-pointer bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 px-3 py-2 rounded-xl text-xs font-semibold flex items-center justify-center gap-2 border border-zinc-300 dark:border-zinc-700 transition-colors">
              <i data-lucide="upload" class="w-4 h-4"></i>
              <span id="uploadLabelText">Обрати фото...</span>
              <input type="file" id="recipeImageFileInput" accept="image/*" class="hidden">
            </label>
          </div>
        </div>

        <!-- Інгредієнти -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label id="ingredientsBlockLabel" class="text-xs font-bold uppercase tracking-wider text-zinc-500">Інгредієнти (на 1 порц.) *</label>
            <button type="button" id="addIngredientRowBtn" class="text-xs font-bold text-orange-500 hover:underline flex items-center gap-1">
              + Додати рядок
            </button>
          </div>
          <div id="ingredientsListContainer" class="space-y-2"></div>
        </div>

        <!-- Покроковий рецепт -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-zinc-500 mb-1">Інструкція приготування</label>
          <textarea id="recipeInstructionsInput" rows="3" placeholder="1. Зварити пасту...&#10;2. Обсмажити креветки..." class="w-full bg-zinc-100 dark:bg-[#20232a] border border-zinc-300 dark:border-zinc-700 rounded-xl px-3 py-2 text-xs leading-relaxed text-zinc-900 dark:text-white focus:outline-none focus:border-orange-500"></textarea>
        </div>

        <!-- Нижня кнопка збереження -->
        <div class="pt-2">
          <button type="submit" class="w-full bg-orange-500 active:bg-orange-600 text-white font-bold py-2.5 rounded-xl text-sm shadow-md shadow-orange-500/20 active:scale-98 transition-all">
            Зберегти рецепт
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- 4. МОДАЛЬНЕ ВІКНО «КЕРУВАННЯ КАТЕГОРІЯМИ» -->
  <div id="categoriesModal" class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-200">
    <div class="relative w-full max-w-md max-h-[85vh] bg-white dark:bg-[#16181d] border border-zinc-200 dark:border-zinc-800 rounded-3xl shadow-2xl flex flex-col overflow-hidden overscroll-contain transition-transform duration-200 scale-95">
      
      <!-- Шапка -->
      <div class="p-4 border-b border-zinc-200 dark:border-zinc-800 flex items-center justify-between shrink-0">
        <h3 class="font-bold text-base text-zinc-900 dark:text-white">Категорії страв</h3>
        <button type="button" class="close-modal-btn w-8 h-8 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 flex items-center justify-center active:scale-90 transition-transform">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>

      <div class="p-4 flex-1 overflow-y-auto overscroll-contain space-y-4">
        <!-- Блок створення нової категорії -->
        <div class="bg-zinc-50 dark:bg-[#1a1c21] p-3 rounded-2xl border border-zinc-200 dark:border-zinc-800 space-y-2">
          <span class="text-xs font-bold uppercase tracking-wider text-orange-500 flex items-center gap-1.5">
            <i data-lucide="plus-circle" class="w-3.5 h-3.5"></i> Створити нову категорію
          </span>

          <div class="flex gap-2 items-center">
            <!-- Квадратне поле для емодзі з контурним SVG-плейсхолдером -->
            <div class="relative flex items-center justify-center w-12 h-10 bg-zinc-100 dark:bg-[#20232a] border border-zinc-300 dark:border-zinc-700 rounded-xl overflow-hidden focus-within:border-orange-500 transition-colors shrink-0">
              <input 
                type="text" 
                id="newCatIconInput" 
                maxlength="2" 
                class="w-full h-full text-center bg-transparent text-lg font-medium text-zinc-900 dark:text-white outline-none z-10 cursor-pointer"
              >
              <div id="newCatIconPlaceholder" class="absolute inset-0 flex items-center justify-center pointer-events-none text-zinc-400 dark:text-zinc-500 z-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10" />
                  <path d="M8 14s1.5 2 4 2 4-2 4-2" />
                  <line x1="9" y1="9" x2="9.01" y2="9" />
                  <line x1="15" y1="9" x2="15.01" y2="9" />
                </svg>
              </div>
            </div>

            <!-- Поле назви категорії -->
            <input 
              type="text" 
              id="newCatNameInput" 
              placeholder="Назва (напр. Мангал, Закуски)" 
              class="flex-1 bg-zinc-100 dark:bg-[#20232a] border border-zinc-300 dark:border-zinc-700 rounded-xl px-3 py-2 text-sm text-zinc-900 dark:text-white focus:outline-none focus:border-orange-500"
            >

            <!-- Кнопка створення з галочкою Check -->
            <button 
              type="button" 
              id="addNewCategoryBtn" 
              disabled
              class="w-10 h-10 bg-orange-500 active:bg-orange-600 text-white font-bold rounded-xl flex items-center justify-center active:scale-95 transition-all opacity-40 shrink-0"
            >
