          openModal("editCatModal");
        });
      });

      container.querySelectorAll(".del-cat-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          const id = btn.dataset.catId;
          if (categories.length <= 1) return;
          categories = categories.filter(c => c.id !== id);
          recipes = recipes.filter(r => r.categoryId !== id);
          saveCategories();
          saveRecipes();
          renderCategoriesManagerList();
          renderCategoryTabs();
          renderMenuFeed();
        });
      });
    }

    // 11. ІНІЦІАЛІЗАЦІЯ ДОДАТКА
    function initApp() {
      setupTheme();
      setupModals();
      setupEmojiInputs();
      setupStrictScrollSpy();

      renderCategoryTabs();
      renderMenuFeed();
      updateFloatingCartBadge();

      // Відкриття кошика
      document.getElementById("openShoppingModalBtn").addEventListener("click", () => {
        renderShoppingListModal();
        openModal("shoppingModal");
      });

      // Експорт у Telegram
      document.getElementById("telegramExportBtn").addEventListener("click", () => {
        const text = generateTelegramText();
        const encodedText = encodeURIComponent(text);
        const deepLink = `tg://msg_url?url=&text=${encodedText}`;
        const webFallback = `https://t.me/share/url?url=&text=${encodedText}`;

        let appOpened = false;
        const handleVisibilityChange = () => {
          if (document.hidden) appOpened = true;
        };
        document.addEventListener("visibilitychange", handleVisibilityChange);

        window.location.href = deepLink;

        setTimeout(() => {
          document.removeEventListener("visibilitychange", handleVisibilityChange);
          if (!appOpened) {
            window.open(webFallback, "_blank");
          }
        }, 650);
      });

      // Копіювання списку
      document.getElementById("copyShoppingListBtn").addEventListener("click", () => {
        const text = generateTelegramText();
        const el = document.createElement("textarea");
        el.value = text;
        document.body.appendChild(el);
        el.select();
        document.execCommand("copy");
        document.body.removeChild(el);

        const btn = document.getElementById("copyShoppingListBtn");
        const orig = btn.innerHTML;
        btn.innerHTML = `<span>Скопійовано!</span>`;
        setTimeout(() => { btn.innerHTML = orig; }, 1500);
      });

      // Відкриття категорій
      document.getElementById("openCategoriesModalBtn").addEventListener("click", () => {
        renderCategoriesManagerList();
        openModal("categoriesModal");
      });

      // Додавання нової категорії
      document.getElementById("addNewCategoryBtn").addEventListener("click", () => {
        const nameInput = document.getElementById("newCatNameInput");
        const iconInput = document.getElementById("newCatIconInput");
        const name = nameInput.value.trim();
        const icon = iconInput.value.trim();

        if (!name) return;

        categories.push({
          id: `cat-${Date.now()}`,
          name: name,
          icon: icon || ""
        });

        saveCategories();

        nameInput.value = "";
        iconInput.value = "";
        document.getElementById("newCatIconPlaceholder").style.opacity = "1";
        document.getElementById("addNewCategoryBtn").disabled = true;
        document.getElementById("addNewCategoryBtn").style.opacity = "0.4";

        renderCategoriesManagerList();
        renderCategoryTabs();
        renderMenuFeed();
      });

      // Збереження редагованої категорії
      document.getElementById("saveEditCatBtn").addEventListener("click", () => {
        const id = document.getElementById("editCatIdInput").value;
        const name = document.getElementById("editCatNameInput").value.trim();
        const icon = document.getElementById("editCatIconInput").value.trim();

        if (!name) return;

        const cat = categories.find(c => c.id === id);
        if (cat) {
          cat.name = name;
          cat.icon = icon || "";
          saveCategories();
          renderCategoriesManagerList();
          renderCategoryTabs();
          renderMenuFeed();
        }
        closeModal("editCatModal");
      });

      // Фото в рецепті
      document.getElementById("recipeImageFileInput").addEventListener("change", (e) => {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (evt) => {
          uploadedImageBase64 = evt.target.result;
          document.getElementById("imagePreviewBox").innerHTML = `<img src="${uploadedImageBase64}" class="w-full h-full object-cover">`;
          document.getElementById("uploadLabelText").innerText = "Змінити фото";
        };
        reader.readAsDataURL(file);
      });

      // Додати рядок інгредієнта
      document.getElementById("addIngredientRowBtn").addEventListener("click", () => {
        addIngredientRow("", "", "г", "vegetables");
      });

      // Збереження форми рецепту
      document.getElementById("newRecipeForm").addEventListener("submit", (e) => {
        e.preventDefault();
        const editId = document.getElementById("editingRecipeId").value;
        const title = document.getElementById("recipeTitleInput").value.trim();
        const categoryId = document.getElementById("recipeCategorySelect").value;
        const time = parseInt(document.getElementById("recipeTimeInput").value) || 20;
        const instructions = document.getElementById("recipeInstructionsInput").value.trim();

        const ingredients = [];
        document.querySelectorAll("#ingredientsListContainer .ingredient-input-row").forEach(row => {
          const name = row.querySelector(".ing-name").value.trim();
          const amount = parseFloat(row.querySelector(".ing-amount").value) || 0;
          const unit = row.querySelector(".ing-unit").value;
          const aisle = row.querySelector(".ing-aisle").value;
          if (name) {
            ingredients.push({ name, amount, unit, aisle });
            // Автоматичне запам'ятовування нового/зміненого продукту в User Memory (localStorage)
            saveUserProduct(name, aisle);
          }
        });

        if (editId) {
          const rec = recipes.find(r => r.id === editId);
          if (rec) {
            rec.title = title;
            rec.categoryId = categoryId;
            rec.time = time;
            rec.instructions = instructions;
            rec.ingredients = ingredients;
            if (uploadedImageBase64 !== undefined) rec.image = uploadedImageBase64;
          }
        } else {
          recipes.push({
            id: `rec-${Date.now()}`,
            categoryId,
            title,
            time,
            image: uploadedImageBase64 || "",
            instructions,
            ingredients
          });
        }

        saveRecipes();
        renderMenuFeed();
        closeModal("newRecipeModal");
      });

      // Відкрити модалку створення рецепту
      document.getElementById("openNewRecipeBtn").addEventListener("click", () => {
        document.getElementById("recipeModalFormTitle").innerText = "Додати свій рецепт";
        document.getElementById("editingRecipeId").value = "";
        document.getElementById("newRecipeForm").reset();
        document.getElementById("recipeInstructionsInput").value = "";
        renderCategorySelectOptions();

        const container = document.getElementById("ingredientsListContainer");
        container.innerHTML = "";
        resetImageUpload();

        addIngredientRow("Куряче філе", 200, "г", "meat");
        addIngredientRow("Вершки 20%", 100, "мл", "dairy");
        openModal("newRecipeModal");
      });

      // Перемикач вкладок у деталях страви
      document.getElementById("tabBtnIngredients").addEventListener("click", () => switchModalTab("ingredients"));
      document.getElementById("tabBtnInstructions").addEventListener("click", () => switchModalTab("instructions"));

      lucide.createIcons();
    }

    function safeCreateIcons() {
      if (window.lucide && typeof window.lucide.createIcons === 'function') {
        try {
          window.lucide.createIcons();
        } catch (e) {
          console.warn("Lucide icons error:", e);
        }
      }
    }

    // 11. ІНІЦІАЛІЗАЦІЯ ДОДАТКА
    function initApp() {
      try {
        setupTheme();
        setupModals();
        setupEmojiInputs();
        setupStrictScrollSpy();

        renderCategoryTabs();
        renderMenuFeed();
        updateFloatingCartBadge();

        // Відкриття кошика
        document.getElementById("openShoppingModalBtn")?.addEventListener("click", () => {
          renderShoppingListModal();
          openModal("shoppingModal");
        });

        // Експорт у Telegram
        document.getElementById("telegramExportBtn")?.addEventListener("click", () => {
          const text = generateTelegramText();
          const encodedText = encodeURIComponent(text);
          const deepLink = `tg://msg_url?url=&text=${encodedText}`;
          const webFallback = `https://t.me/share/url?url=&text=${encodedText}`;

          let appOpened = false;
          const handleVisibilityChange = () => {
            if (document.hidden) appOpened = true;
          };
          document.addEventListener("visibilitychange", handleVisibilityChange);

          window.location.href = deepLink;

          setTimeout(() => {
            document.removeEventListener("visibilitychange", handleVisibilityChange);
            if (!appOpened) {
              window.open(webFallback, "_blank");
            }
          }, 650);
        });

        // Копіювання списку
        document.getElementById("copyShoppingListBtn")?.addEventListener("click", () => {
          const text = generateTelegramText();
          const el = document.createElement("textarea");
          el.value = text;
          document.body.appendChild(el);
          el.select();
          document.execCommand("copy");
          document.body.removeChild(el);

          const btn = document.getElementById("copyShoppingListBtn");
          if (btn) {
            const orig = btn.innerHTML;
            btn.innerHTML = `<span>Скопійовано!</span>`;
            setTimeout(() => { btn.innerHTML = orig; }, 1500);
          }
        });

        // Відкриття категорій
        document.getElementById("openCategoriesModalBtn")?.addEventListener("click", () => {
          renderCategoriesManagerList();
          openModal("categoriesModal");
        });

        // Додавання нової категорії
        document.getElementById("addNewCategoryBtn")?.addEventListener("click", () => {
          const nameInput = document.getElementById("newCatNameInput");
          const iconInput = document.getElementById("newCatIconInput");
          const name = nameInput ? nameInput.value.trim() : "";
          const icon = iconInput ? iconInput.value.trim() : "";

          if (!name) return;

          categories.push({
            id: `cat-${Date.now()}`,
            name: name,
            icon: icon || ""
          });

          saveCategories();

          if (nameInput) nameInput.value = "";
          if (iconInput) iconInput.value = "";
          const placeholder = document.getElementById("newCatIconPlaceholder");
          if (placeholder) placeholder.style.opacity = "1";
          const addBtn = document.getElementById("addNewCategoryBtn");
          if (addBtn) {
            addBtn.disabled = true;
            addBtn.style.opacity = "0.4";
          }

          renderCategoriesManagerList();
          renderCategoryTabs();
          renderMenuFeed();
        });

        // Збереження редагованої категорії
        document.getElementById("saveEditCatBtn")?.addEventListener("click", () => {
          const id = document.getElementById("editCatIdInput")?.value;
          const name = document.getElementById("editCatNameInput")?.value.trim();
          const icon = document.getElementById("editCatIconInput")?.value.trim();

          if (!name) return;

          const cat = categories.find(c => c.id === id);
          if (cat) {
            cat.name = name;
            cat.icon = icon || "";
            saveCategories();
            renderCategoriesManagerList();
            renderCategoryTabs();
            renderMenuFeed();
          }
          closeModal("editCatModal");
        });

        // Фото в рецепті
        document.getElementById("recipeImageFileInput")?.addEventListener("change", (e) => {
          const file = e.target.files[0];
          if (!file) return;
          const reader = new FileReader();
          reader.onload = (evt) => {
            uploadedImageBase64 = evt.target.result;
            const previewBox = document.getElementById("imagePreviewBox");
            if (previewBox) {
              previewBox.innerHTML = `<img src="${uploadedImageBase64}" class="w-full h-full object-cover">`;
            }
            const labelText = document.getElementById("uploadLabelText");
            if (labelText) labelText.innerText = "Змінити фото";
          };
          reader.readAsDataURL(file);
        });

        // Додати рядок інгредієнта
        document.getElementById("addIngredientRowBtn")?.addEventListener("click", () => {
          addIngredientRow("", "", "г", "");
        });

        // Слухач зміни кількості порцій для динамічного оновлення лейбла
        document.getElementById("recipePortionsInput")?.addEventListener("input", (e) => {
          updateIngredientsBlockLabel(e.target.value);
        });

        // Збереження форми рецепту
        document.getElementById("newRecipeForm")?.addEventListener("submit", (e) => {
          e.preventDefault();
          const editId = document.getElementById("editingRecipeId")?.value;
          const title = document.getElementById("recipeTitleInput")?.value.trim();
          const categoryId = document.getElementById("recipeCategorySelect")?.value;
          const portionsRaw = document.getElementById("recipePortionsInput")?.value;
          const portions = parseInt(portionsRaw);
          const timeRaw = document.getElementById("recipeTimeInput")?.value;
          const time = timeRaw ? (parseInt(timeRaw) || 0) : 0;
          const instructions = document.getElementById("recipeInstructionsInput")?.value.trim();

          if (!title) {
            alert("Будь ласка, вкажіть назву страви.");
            return;
          }

          if (!categoryId) {
            alert("Будь ласка, оберіть категорію страви.");
            return;
          }

          if (!portions || portions < 1) {
            alert("Будь ласка, вкажіть дійсну кількість порцій (мінімум 1).");
            return;
          }

          const ingredients = [];
          let hasInvalidAisle = false;

          document.querySelectorAll("#ingredientsListContainer .ingredient-input-row").forEach(row => {
            const name = row.querySelector(".ing-name")?.value.trim();
            const amount = parseFloat(row.querySelector(".ing-amount")?.value) || 0;
            const unit = row.querySelector(".ing-unit")?.value || "г";
            const aisle = row.querySelector(".ing-aisle")?.value || "";

            if (name) {
              if (!aisle) {
                hasInvalidAisle = true;
              }
              ingredients.push({ name, amount, unit, aisle: aisle || "other" });
              if (aisle) {
                saveCustomIngredient(name, aisle);
              }
            }
          });

          if (ingredients.length === 0) {
            alert("Будь ласка, додайте хоча б один інгредієнт.");
            return;
          }

          if (hasInvalidAisle) {
            alert("Будь ласка, оберіть відділ супермаркету для всіх вказаних інгредієнтів.");
            return;
          }

          if (editId) {
            const rec = recipes.find(r => r.id === editId);
            if (rec) {
              rec.title = title;
              rec.categoryId = categoryId;
              rec.portions = portions;
              rec.time = time;
              rec.instructions = instructions;
              rec.ingredients = ingredients;
              if (uploadedImageBase64 !== undefined) rec.image = uploadedImageBase64;
            }
          } else {
            recipes.push({
              id: `rec-${Date.now()}`,
              categoryId,
              title,
              portions,
              time,
              image: uploadedImageBase64 || "",
              instructions,
              ingredients
            });
          }

          saveRecipes();
          renderMenuFeed();
          closeModal("newRecipeModal");
        });

        // Відкрити модалку створення рецепту
        document.getElementById("openNewRecipeBtn")?.addEventListener("click", () => {
          const formTitle = document.getElementById("recipeModalFormTitle");
          if (formTitle) formTitle.innerText = "Додати свій рецепт";
          const editInput = document.getElementById("editingRecipeId");
          if (editInput) editInput.value = "";
          const form = document.getElementById("newRecipeForm");
          if (form) form.reset();
          const titleInput = document.getElementById("recipeTitleInput");
          if (titleInput) titleInput.value = "";
          const portionsInput = document.getElementById("recipePortionsInput");
          if (portionsInput) portionsInput.value = "";
          updateIngredientsBlockLabel(1);
          const timeInput = document.getElementById("recipeTimeInput");
          if (timeInput) timeInput.value = "";
          const instructions = document.getElementById("recipeInstructionsInput");
          if (instructions) instructions.value = "";
          renderCategorySelectOptions("");

          const container = document.getElementById("ingredientsListContainer");
          if (container) container.innerHTML = "";
          resetImageUpload();

          // Додаємо рівно 1 чистий рядок інгредієнта без дефолтних продуктів
          addIngredientRow("", "", "г", "");
          openModal("newRecipeModal");
        });

        // Перемикач вкладок у деталях страви
        document.getElementById("tabBtnIngredients")?.addEventListener("click", () => switchModalTab("ingredients"));
        document.getElementById("tabBtnInstructions")?.addEventListener("click", () => switchModalTab("instructions"));

        safeCreateIcons();
      } catch (err) {
        console.error("Помилка під час запуску initApp:", err);
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initApp);
    } else {
      initApp();
    }
  </script>
