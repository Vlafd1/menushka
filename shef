    // 8. СПИСОК ЗАКУПІВЛІ ТА TELEGRAM
    function calculateShoppingData() {
      const aggregated = {};

      for (const [recipeId, portions] of Object.entries(selectedMenu)) {
        if (portions <= 0) continue;
        const recipe = recipes.find(r => r.id === recipeId);
        if (!recipe) continue;

        (recipe.ingredients || []).forEach(ing => {
          let matchedAisle = detectAisleByName(ing.name, ing.aisle);
          if (matchedAisle === "cheese") matchedAisle = "dairy";
          const key = `${ing.name.toLowerCase().trim()}_${ing.unit}`;
          if (!aggregated[key]) {
            aggregated[key] = {
              name: ing.name.trim(),
              amount: 0,
              unit: ing.unit,
              aisle: matchedAisle
            };
          }
          aggregated[key].amount += (ing.amount * portions);
        });
      }

      const aisleOrder = ["meat", "dairy", "vegetables", "fruits", "grocery", "fish", "spices", "bakery", "other"];
      const byAisle = {};

      aisleOrder.forEach(key => {
        const items = Object.values(aggregated).filter(item => item.aisle === key);
        if (items.length > 0) {
          byAisle[key] = items;
        }
      });

      return byAisle;
    }

    function renderShoppingListModal() {
      const grouped = calculateShoppingData();
      const container = document.getElementById("shoppingListContent");

      const aisleKeys = Object.keys(grouped);
      if (aisleKeys.length === 0) {
        container.innerHTML = `<div class="text-center py-8 text-zinc-400 dark:text-zinc-500 text-xs">Не обрано жодної страви</div>`;
        return;
      }

      container.innerHTML = aisleKeys.map(aisleKey => {
        const aisleInfo = AISLES[aisleKey] || AISLES.other;
        const items = grouped[aisleKey];

        return `
          <div class="bg-zinc-50 dark:bg-[#1a1c21] border border-zinc-200 dark:border-zinc-800 rounded-2xl p-3 space-y-2">
            <div class="flex items-center gap-2 border-b border-zinc-200 dark:border-zinc-800 pb-2">
              <span class="text-base">${aisleInfo.icon}</span>
              <h4 class="text-xs font-bold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider">${aisleInfo.title}</h4>
            </div>

            <div class="space-y-1 pt-1">
              ${items.map(item => {
                const itemKey = `${item.name}_${item.unit}`;
                const isChecked = excludedShoppingItems.has(itemKey);
                return `
                  <label class="flex items-center justify-between p-1.5 rounded-lg active:bg-zinc-200/60 dark:active:bg-zinc-800/40 cursor-pointer text-xs select-none">
                    <div class="flex items-center gap-2">
                      <input type="checkbox" data-item-key="${itemKey}" ${isChecked ? "checked" : ""} class="shopping-item-toggle w-4 h-4 rounded border-zinc-300 dark:border-zinc-700 text-orange-500 focus:ring-0 bg-white dark:bg-[#20232a]">
                      <span class="${isChecked ? "line-through text-zinc-400 dark:text-zinc-600" : "text-zinc-800 dark:text-zinc-200 font-medium"}">${item.name}</span>
                    </div>
                    <span class="font-bold ${isChecked ? "text-zinc-400 dark:text-zinc-600" : "text-orange-500"}">${item.amount} ${item.unit}</span>
                  </label>
                `;
              }).join("")}
            </div>
          </div>
        `;
      }).join("");

      container.querySelectorAll(".shopping-item-toggle").forEach(chk => {
        chk.addEventListener("change", (e) => {
          const key = e.target.dataset.itemKey;
          if (e.target.checked) {
            excludedShoppingItems.add(key);
          } else {
            excludedShoppingItems.delete(key);
          }
          renderShoppingListModal();
        });
      });
    }

    function generateTelegramText() {
      const grouped = calculateShoppingData();
      let text = "🛒 СПИСОК ЗАКУПІВЛІ (МЕНЮШКА)\n";

      text += "\n🍽 ДО СТОЛУ:\n";
      for (const [rId, portions] of Object.entries(selectedMenu)) {
        const recipe = recipes.find(r => r.id === rId);
        if (recipe) text += `• ${recipe.title} — ${portions} порц.\n`;
      }

      text += "\n────────────────────\n";

      for (const [aisleKey, items] of Object.entries(grouped)) {
        const activeItems = items.filter(it => !excludedShoppingItems.has(`${it.name}_${it.unit}`));
        if (activeItems.length === 0) continue;

        const aisle = AISLES[aisleKey] || AISLES.other;
        text += `\n${aisle.icon} ${aisle.title.toUpperCase()}:\n`;
        activeItems.forEach(it => {
          text += `  ▫️ ${it.name} — ${it.amount} ${it.unit}\n`;
        });
      }

      return text;
    }

