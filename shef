        const parsed = saved ? JSON.parse(saved) : [];
        return Array.isArray(parsed) ? parsed : [];
      } catch (e) {
        console.error("Помилка читання localStorage custom_ingredients:", e);
        return [];
      }
    };

    // Збереження користувацького інгредієнта з автоматичним російським аліасом
    function saveCustomIngredient(name, categoryOrAisleKey) {
      if (!name || !name.trim()) return;
      const cleanName = name.trim();
      
      // Визначаємо текстову назву категорії
      const categoryName = AISLE_KEY_TO_CATEGORY[categoryOrAisleKey] || categoryOrAisleKey || "Інше";

      const list = getStoredIngredients();
      const existingIdx = list.findIndex(p => p.name.toLowerCase() === cleanName.toLowerCase());

      // Простий російський аліас (транслітерація і -> и, є -> е, ї -> и)
      const ruAlias = cleanName.toLowerCase()
        .replace(/і/g, 'и')
        .replace(/є/g, 'е')
        .replace(/ї/g, 'и');

      const aliases = [cleanName.toLowerCase()];
      if (ruAlias !== cleanName.toLowerCase()) {
        aliases.push(ruAlias);
      }

      if (existingIdx >= 0) {
        list[existingIdx].category = categoryName;
        if (!Array.isArray(list[existingIdx].aliases)) list[existingIdx].aliases = [];
        aliases.forEach(a => {
          if (!list[existingIdx].aliases.includes(a)) list[existingIdx].aliases.push(a);
        });
      } else {
        list.push({
          name: cleanName,
          category: categoryName,
          aliases: aliases
        });
      }

      try {
        localStorage.setItem('menushka_custom_ingredients', JSON.stringify(list));
      } catch (e) {
        console.error("Помилка запису в localStorage custom_ingredients:", e);
      }
    }

    // Безпечний пошук для автокомпліту за назвою та аліасами
    const searchIngredients = (query) => {
      const cleanQuery = (query || "").trim().toLowerCase();
      if (!cleanQuery) return [];

      const customList = getStoredIngredients();
      const allItems = [...DEFAULT_INGREDIENTS, ...customList];

      return allItems.filter(item => {
        if (!item || !item.name) return false;
        const nameMatch = item.name.toLowerCase().includes(cleanQuery);
        const aliasMatch = Array.isArray(item.aliases) && item.aliases.some(
          alias => typeof alias === "string" && alias.toLowerCase().includes(cleanQuery)
        );
        return nameMatch || aliasMatch;
      }).slice(0, 7); // Максимум 7 підказок
    };

    // Розумний класифікатор / авто-маппінг за ключовими словами
    function detectAisleByName(name, explicitAisle = "") {
      const lower = (name || "").toLowerCase().trim();

      // Спочатку перевіряємо збережені користувацькі інгредієнти
      const customList = getStoredIngredients();
      const customMatch = customList.find(p => p && p.name && p.name.toLowerCase() === lower);
      if (customMatch && customMatch.category) {
        return CATEGORY_TO_AISLE_KEY[customMatch.category] || "other";
      }

      // Перевіряємо базу DEFAULT_INGREDIENTS
      const defaultMatch = DEFAULT_INGREDIENTS.find(p => p && p.name && p.name.toLowerCase() === lower);
      if (defaultMatch && defaultMatch.category) {
        return CATEGORY_TO_AISLE_KEY[defaultMatch.category] || "other";
      }

      // Молочні продукти, яйця та ВСІ види сирів (об'єднані в dairy)
      if (
        lower.includes("вершк") || lower.includes("сливк") || lower.includes("молок") ||
        lower.includes("сметан") || lower.includes("кефір") || lower.includes("кефир") ||
        lower.includes("масло вершков") || lower.includes("сливочное масло") ||
        lower.includes("яйц") || lower.includes("жовт") || lower.includes("желт") || lower.includes("білок") ||
        lower.includes("сир") || lower.includes("сыр") || lower.includes("пармезан") ||
        lower.includes("моцарел") || lower.includes("моцарелла") || lower.includes("фета") ||
        lower.includes("пекоріно") || lower.includes("пекорино") || lower.includes("маскарпоне") ||
        lower.includes("чеддер") || lower.includes("чедер") || lower.includes("сулугуні") ||
        lower.includes("сулугуни") || lower.includes("дорблю") || lower.includes("горгонзол") ||
        lower.includes("творог")
      ) {
        return "dairy";
      }

      // М'ясо та ковбаси
      if (
        lower.includes("м'яс") || lower.includes("мяс") || lower.includes("філе") ||
        lower.includes("филе") || lower.includes("курк") || lower.includes("куриц") ||
        lower.includes("куряч") || lower.includes("яловичин") || lower.includes("говядин") ||
        lower.includes("свинин") || lower.includes("бекон") || lower.includes("гуанчале") ||
        lower.includes("фарш") || lower.includes("стейк") || lower.includes("ковбас") ||
        lower.includes("колбас") || lower.includes("сосиск") || lower.includes("рібай") || lower.includes("рибай")
      ) {
        return "meat";
      }

      // Риба та морепродукти
      if (
        lower.includes("риб") || lower.includes("рыб") || lower.includes("лосос") ||
        lower.includes("сьомг") || lower.includes("семг") || lower.includes("тунец") ||
        lower.includes("тунц") || lower.includes("кревет") || lower.includes("мідії") || lower.includes("мидии")
      ) {
        return "fish";
      }

      // Овочі, гриби та зелень
      if (
        lower.includes("томат") || lower.includes("помідор") || lower.includes("помидор") ||
        lower.includes("огірок") || lower.includes("огур") || lower.includes("печериц") ||
        lower.includes("шампиньон") || lower.includes("гриб") || lower.includes("базилік") ||
        lower.includes("базилик") || lower.includes("кріп") || lower.includes("укроп") ||
        lower.includes("розмарин") || lower.includes("часник") || lower.includes("чеснок") ||
        lower.includes("цибул") || lower.includes("лук") || lower.includes("картопл") ||
        lower.includes("картофел") || lower.includes("моркв") || lower.includes("морков") ||
        lower.includes("зелен") || lower.includes("салат")
      ) {
        return "vegetables";
      }

      // Фрукти та ягоди
      if (
        lower.includes("ягід") || lower.includes("ягод") || lower.includes("яблук") ||
        lower.includes("яблок") || lower.includes("лимон") || lower.includes("банан") ||
        lower.includes("джем") || lower.includes("полуниц") || lower.includes("клубник") ||
        lower.includes("малин") || lower.includes("чорниц") || lower.includes("черник")
      ) {
        return "fruits";
      }

      // Випічка та кондитерка
      if (
        lower.includes("ванільн") || lower.includes("ванильн") || lower.includes("розпушувач") ||
        lower.includes("разрыхлитель") || lower.includes("шоколад") || lower.includes("дріждж") ||
        lower.includes("дрожжи")
      ) {
        return "bakery";
      }

      // Спеції, олії та соуси
      if (
        lower.includes("олі") || lower.includes("масло оливков") || lower.includes("растительное масло") ||
        lower.includes("перець") || lower.includes("перец") || lower.includes("сіль") ||
