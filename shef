        const iconHtml = cat.icon ? `<span>${cat.icon}</span>` : "";
        return `
          <button 
            type="button" 
            data-cat-id="${cat.id}" 
            class="cat-pill flex-shrink-0 flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold active:scale-95 transition-all"
          >
            ${iconHtml}
            <span>${cat.name}</span>
          </button>
        `;
      }).join("");

      container.querySelectorAll(".cat-pill").forEach(btn => {
        btn.addEventListener("click", () => {
          const catId = btn.dataset.catId;
          const section = document.getElementById(`section-${catId}`);
          if (section) {
            const nav = document.querySelector("[data-categories-nav]");
            const offset = (nav?.getBoundingClientRect().bottom || 110) + 10;
            const top = section.getBoundingClientRect().top + window.scrollY - offset;
            window.scrollTo({ top, behavior: "smooth" });
          }
          activeCategoryId = catId;
          updateTabsStyle(true);
        });
      });

      updateTabsStyle();
    }

    function updateTabsStyle(scrollIntoView = false) {
      document.querySelectorAll("#categoryTabsContainer .cat-pill").forEach(btn => {
        const id = btn.dataset.catId;
        const isActive = id === activeCategoryId;
        if (isActive) {
          btn.className = "cat-pill flex-shrink-0 flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-orange-500 text-white shadow-md shadow-orange-500/20 active:scale-95 transition-all";
          if (scrollIntoView) {
            btn.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
          }
        } else {
          btn.className = "cat-pill flex-shrink-0 flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-800 active:scale-95 transition-all";
        }
      });
    }

    function setupStrictScrollSpy() {
      window.addEventListener("scroll", () => {
        if (window.scrollY < 20) {
          if (categories[0] && activeCategoryId !== categories[0].id) {
            activeCategoryId = categories[0].id;
            updateTabsStyle(true);
          }
          return;
        }

        const navBar = document.querySelector("[data-categories-nav]");
        const navBottom = navBar ? navBar.getBoundingClientRect().bottom : 110;
        const zoneTop = navBottom;
        const zoneBottom = navBottom + 45;

        const titles = document.querySelectorAll(".category-title-trigger");
        titles.forEach(title => {
          const rect = title.getBoundingClientRect();
          if (rect.top <= zoneBottom && rect.bottom >= zoneTop) {
            const id = title.getAttribute("data-id");
            if (id && id !== activeCategoryId) {
              activeCategoryId = id;
              updateTabsStyle(true);
            }
          }
        });
      }, { passive: true });
    }

